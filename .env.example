# Copy to .env and adjust. Every value below has a default in settings.py,
# so the suite also runs with no .env file at all.

UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://dummyjson.com

# saucedemo.com publishes these credentials on its own login page
UI_USERNAME=standard_user
UI_PASSWORD=secret_sauce

# dummyjson.com publishes these in its docs
API_USERNAME=emilys
API_PASSWORD=emilyspass

HTTP_TIMEOUT=15
